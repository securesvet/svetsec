# Generate this value with:
# cargo run -q -p svetsec-server -- hash-password 'choose-a-long-password'
SVETSEC_OWNER_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace$replace'

SVETSEC_DATABASE='svetsec.db'
SVETSEC_HTTP_ADDR='127.0.0.1:3000'
SVETSEC_SSH_ADDR='0.0.0.0:2222'
SVETSEC_OWNER_USER='owner'
SVETSEC_STATIC_DIR='dist'
SVETSEC_GITHUB_REPOSITORY='securesvet/svetsec'
SVETSEC_GITHUB_BRANCH='main'
SVETSEC_SECURE_COOKIE='true'

# Docker Compose host ports (ignored by the server process itself):
SVETSEC_HTTP_PORT='3000'
SVETSEC_SSH_PORT='2222'

# Uncomment both for local development to read Markdown and images from this folder:
# SVETSEC_ARTICLES_SOURCE='local'
# SVETSEC_ARTICLES_DIR='articles'

# Required to enable SSH outside Docker. The production Compose deployment
# instead mounts shared/owner_ed25519.pub and shared/ssh_host_ed25519_key:
# SVETSEC_OWNER_PUBLIC_KEY_FILE='/absolute/path/to/id_ed25519.pub'
# SVETSEC_SSH_HOST_KEY_FILE='/absolute/path/to/ssh_host_ed25519_key'

# Optional server-side Pyodide runner settings:
SVETSEC_PYODIDE_NODE='node'
SVETSEC_PYODIDE_RUNNER='scripts/pyodide-runner.mjs'
SVETSEC_PYODIDE_NODE_MODULES='node_modules'
